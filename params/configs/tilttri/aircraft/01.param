# Aircraft 01 — tilt servo + FW level (config: tilttri)
# Q_TILT_TYPE=2 does not use TRIM as the VTOL center. It interpolates
# MIN↔MAX (Q_TILT_YAW_ANGLE past 90° = scaled 0). REVERSED is set so
# QSTABILIZE lands near TRIM (vertical) and fully-fwd near the below-level end.
# Upload: upload-params.py --aircraft 01

# S5 TiltMotorLeft (FUNCTION 75) — REVERSED=0
SERVO5_MIN,950
SERVO5_TRIM,1150
SERVO5_MAX,2200
SERVO5_REVERSED,0

# S6 TiltMotorRight (FUNCTION 76) — REVERSED=1
SERVO6_MIN,950
SERVO6_TRIM,1950
SERVO6_MAX,2200
SERVO6_REVERSED,1

Q_TILT_YAW_ANGLE,15

# TRI front/rear mixer scale (needs ArduPlane V4.6.3-thstfac). Bench: FRONT 0.8 / REAR 1.2.
Q_M_THST_FRONT,0.8
Q_M_THST_REAR,1.2

# Pitch rate damping after log 111: stick-centered nose-down at ThO~0.33.
# Leave Q_A_ANG_PIT_P and Q_A_RAT_PIT_P at project values (3.5 / 0.25).
Q_A_RAT_PIT_D,0.008
Q_A_RAT_PIT_I,0.18

# Lua FW level (BTILT_HORIZ_*)
BTILT_HORIZ_L,2000
BTILT_HORIZ_R,1090
BTILT_GAIN,0.12
